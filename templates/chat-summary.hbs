<div class="scorpxp-chat">
  <h3><i class="fa-solid fa-trophy"></i> {{localize "SCORPXP.Chat.Header"}}</h3>
  <p class="scorpxp-chat-reason">{{reason}}</p>
  <p class="scorpxp-chat-amount">{{localize "SCORPXP.Chat.Awarded"}} <strong>{{amount}} XP</strong></p>
  <ul class="scorpxp-chat-list">
    {{#each recipients}}
    <li><img src="{{this.img}}" alt="{{this.name}}" width="20" height="20" /> {{this.name}}</li>
    {{/each}}
  </ul>
</div>
